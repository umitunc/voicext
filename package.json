{
  "name": "voicext",
  "version": "1.0.3",
  "productName": "VoiceXt",
  "description": "High Performance Local AI Transcription Tool",
  "main": "./out/main/index.js",
  "author": "Truncgil Software",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "npm version patch --no-git-tag-version && electron-vite build && electron-builder --win",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "package:store": "npm version patch --no-git-tag-version && electron-vite build && electron-builder --win appx",
    "release": "npm version patch --no-git-tag-version && electron-vite build && electron-builder --publish always",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@headlessui/react": "^2.0.0",
    "adm-zip": "^0.5.17",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^11.2.10",
    "iconv-lite": "^0.7.2",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "com.voicext.app",
    "productName": "VoiceXt",
    "asar": true,
    "directories": {
      "output": "out/make",
      "buildResources": "build"
    },
    "files": [
      "out/main/index.js",
      "out/preload/index.js",
      "out/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*",
          "!models/**/*"
        ]
      },
      {
        "from": "scratch",
        "to": "scratch",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "appx"
      ],
      "icon": "resources/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "appx": {
      "identityName": "TruncgilTeknoloji.VoiceXT",
      "publisher": "CN=36E5CC36-2B19-4151-A2CF-66EF42CB6EBD",
      "publisherDisplayName": "Truncgil Teknoloji",
      "applicationId": "VoiceXT",
      "languages": [
        "tr-TR",
        "en-US"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "VoiceXt",
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://git.truncgil.com/truncgit/voicext"
    }
  }
}
